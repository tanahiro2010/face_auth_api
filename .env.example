POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=face_auth
ADMINER_PORT=8080

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/face_auth
FACE_MATCH_THRESHOLD=0.5

# 認識性能モード: fast / balanced / accurate / custom
# fast: buffalo_l, 512, tileなし。既存embedding互換のCPUサーバー向け
# balanced: buffalo_l, 640, tileなし
# accurate: buffalo_l, 960, 2x2 tile。重いが検出に強い
FACE_RECOGNITION_MODE=balanced

# 顔検出まわりの調整（値を上げるほど小さい顔を検出しやすくなるが処理が重くなる）
# FACE_RECOGNITION_MODE=custom のときに直接使われます
FACE_DET_SIZE=960
FACE_TILE_GRID=2
FACE_TILE_OVERLAP=0.2

# 同一人物の角度サンプル自動学習
FACE_SAMPLE_DUPLICATE_THRESHOLD=0.94
FACE_AUTO_ENROLL_MIN_SIMILARITY=0.68
FACE_MAX_SAMPLES_PER_PERSON=32

# INSIGHTFACE_MODEL_NAMEを変更すると既存の顔特徴量とは比較できません。
# モデル変更時は登録者を再登録してください。
